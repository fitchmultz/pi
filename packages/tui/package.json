{
	"name": "@earendil-works/pi-tui",
	"version": "1.6.1",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./exif-orientation": {
			"types": "./dist/exif-orientation.d.ts",
			"import": "./dist/exif-orientation.js",
			"default": "./dist/exif-orientation.js"
		},
		"./native/*": "./native/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:linux": "native/linux/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"files": [
		"dist/**/*",
		"native/napi.h",
		"native/clipboard.h",
		"native/darwin/prebuilds/darwin-arm64/*.node",
		"native/darwin/src/**/*.m",
		"native/darwin/build.sh",
		"native/darwin/README.md",
		"native/linux/prebuilds/**/*.node",
		"native/linux/src/**/*.{c,h}",
		"native/linux/build.sh",
		"native/linux/README.md",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fitchmultz/pi.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": "^22.23.5 || ^24.22.3 || >=26.13.1"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"diff": "9.0.0",
		"get-east-asian-width": "1.7.0",
		"marked": "18.2.1",
		"marked-cjk-friendly": "0.1.3"
	},
	"devDependencies": {
		"@xterm/headless": "6.0.0",
		"chalk": "6.0.1"
	}
}
