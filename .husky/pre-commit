#!/bin/sh
set -eu

# Check staged paths without formatting or restaging anyone's work. Full graph
# validation belongs to npm run verify:fork and required CI, not every commit.
node scripts/check-lockfile-commit.mjs
git diff --cached --check
npm exec --no -- biome check --staged --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true --no-errors-on-unmatched --error-on-warnings
